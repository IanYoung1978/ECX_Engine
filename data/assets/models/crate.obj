# Cube with 24 vertices (4 per face) for correct normal mapping
o Cube

# +Y face (top)
v -1.000000  1.000000  1.000000
v  1.000000  1.000000  1.000000
v  1.000000  1.000000 -1.000000
v -1.000000  1.000000 -1.000000

# -Y face (bottom)
v -1.000000 -1.000000 -1.000000
v  1.000000 -1.000000 -1.000000
v  1.000000 -1.000000  1.000000
v -1.000000 -1.000000  1.000000

# +Z face (front)
v -1.000000 -1.000000  1.000000
v  1.000000 -1.000000  1.000000
v  1.000000  1.000000  1.000000
v -1.000000  1.000000  1.000000

# -Z face (back)
v  1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 -1.000000
v -1.000000  1.000000 -1.000000
v  1.000000  1.000000 -1.000000

# -X face (left)
v -1.000000 -1.000000 -1.000000
v -1.000000 -1.000000  1.000000
v -1.000000  1.000000  1.000000
v -1.000000  1.000000 -1.000000

# +X face (right)
v  1.000000 -1.000000  1.000000
v  1.000000 -1.000000 -1.000000
v  1.000000  1.000000 -1.000000
v  1.000000  1.000000  1.000000

# UVs
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# Normals (one per face)
vn  0.000000  1.000000  0.000000
vn  0.000000 -1.000000  0.000000
vn  0.000000  0.000000  1.000000
vn  0.000000  0.000000 -1.000000
vn -1.000000  0.000000  0.000000
vn  1.000000  0.000000  0.000000

s off

# +Y face (top)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# -Y face (bottom)
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# +Z face (front)
f 9/1/3 10/2/3 11/3/3
f 9/1/3 11/3/3 12/4/3

# -Z face (back)
f 13/1/4 14/2/4 15/3/4
f 13/1/4 15/3/4 16/4/4

# -X face (left)
f 17/1/5 18/2/5 19/3/5
f 17/1/5 19/3/5 20/4/5

# +X face (right)
f 21/1/6 22/2/6 23/3/6
f 21/1/6 23/3/6 24/4/6
