<?xml version="1.0"?>
<Scene>
	<Manifest>
		<HDR alias="nightsky">data/assets/Images/Skybox/qwantani_moon_noon_puresky_4k.hdr</HDR>
		<LuaScript alias="keydown">data/scripts/LUA/DebugSceneKeyDown.lua</LuaScript>
		<LuaScript alias="keyup">data/scripts/LUA/OnKeyUp.lua</LuaScript>
		<LuaScript alias="keyheld">data/scripts/LUA/ArcadeKeyHeld.lua</LuaScript>
		<LuaScript alias="mousemove">data/scripts/LUA/onMouseMove.lua</LuaScript>
		<LuaScript alias="collision">data/scripts/LUA/ArcadeCollision.lua</LuaScript>
		<LuaScript alias="movementfeedback">data/scripts/LUA/ArcadeMovementFeedback.lua</LuaScript>
		<LuaScript alias="debugoverlay">data/scripts/LUA/DebugOverlay.lua</LuaScript>
	</Manifest>

	<!-- Verification scene for EC_VoxelChunkSystem (see the "Voxel terrain: entity-per-
	     chunk streaming integration" plan) - the chunk grid itself is NOT authored here;
	     EC_VoxelChunkSystem::init() spawns it unconditionally (a permanent subsystem, not
	     scene-gated), so this scene only needs a camera, light, and skybox to view it. -->

	<Entity uid="400" name="voxelchunk_skybox">
		<Skybox>
			<HDR alias="nightsky"/>
			<!-- Aligns the HDR panorama's own baked-in sun with voxelchunk_sun's new,
			     near-horizon light direction - tuned by eye, adjust if they drift apart. -->
			<Rotation>0.0</Rotation>
		</Skybox>
	</Entity>

	<Entity uid="401" name="voxelchunk_camera">
		<Camera>
			<FOV>60.0</FOV>
			<DrawDistance>300.0</DrawDistance>
		</Camera>
		<Spatial>
			<!-- Centered over the box terrain (TerrainGeneration.lua's box is centered at
			     16,9,16, top surface roughly y=6..16) and well above it, so there's a real
			     fall to demonstrate before the capsule settles onto the surface. -->
			<Position>16.0,30.0,16.0</Position>
			<Orientation>0.0,0.0,0.0</Orientation>
		</Spatial>
		<!-- Human-ish capsule (0.5 radius, 2.0 total height) around the camera, so it has
		     real collision geometry to fall and rest on rather than just being a viewpoint. -->
		<Collider>
			<Type>Capsule</Type>
			<Radius>0.5</Radius>
			<Height>2.0</Height>
			<Center>0.0,0.0,0.0</Center>
		</Collider>
		<!-- "Arcade physics": a Kinematic body still gets gravity (see
		     EC_DOD_RigidBody::ignoreGravity's own comment - orthogonal to BodyType) and
		     still generates real OnCollisionBegin/OnCollisionEnd events, but
		     EC_PhysicsResolution never runs its impulse solver on it - ArcadeCollision.lua's
		     OnCollisionBegin handler decides what happens on contact instead (see
		     EC_BodyType's own comment). mass/restitution/friction below are irrelevant since
		     the impulse solver never touches this entity either way. -->
		<RigidBody><BodyType>Kinematic</BodyType></RigidBody>
		<ScriptComponent>
			<OnKeyDown alias="keydown"/>
			<OnKeyUp alias="keyup"/>
			<OnKeyHeld alias="keyheld"/>
			<OnMouseMove alias="mousemove"/>
			<OnUpdate alias="movementfeedback"/>
			<OnCollisionBegin alias="collision"/>
			<OnCollisionEnd alias="collision"/>
		</ScriptComponent>
	</Entity>

	<!-- voxelchunk_camera's own OnUpdate is already taken by ArcadeGravity.lua (an entity can
	     only have one handler per event type) - a separate host entity is the simplest way
	     to also tick DebugOverlay.lua's FPS/log UI every frame in this scene. -->
	<Entity name="voxelchunk_debug_overlay_host">
		<ScriptComponent>
			<OnUpdate alias="debugoverlay"/>
		</ScriptComponent>
	</Entity>

	<Entity uid="402" name="voxelchunk_sun">
		<Light>
			<Type>Directional</Type>
			<!-- Low, near-horizon sun (mostly horizontal, small downward tilt) so shadows
			     stretch long across the hills - a good stress test for the shadow bias
			     tuning at grazing angles, not just the near-overhead case. -->
			<Direction>0.95,-0.12,0.3,0.0</Direction>
			<Colour>1.0,1.0,1.0,1.0</Colour>
			<Intensity>1.0</Intensity>
			<CastsShadow>true</CastsShadow>
			<Dynamic>false</Dynamic>
		</Light>
	</Entity>
</Scene>
