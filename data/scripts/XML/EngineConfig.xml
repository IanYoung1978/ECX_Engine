<?xml version="1.0"?>
<EngineSettings>
	<Spatial></Spatial>
	<Collision>
		<!-- brodphase algorithm: octree/SAP/hybrid-->
		<BroadPhase algorithm="hybrid"></BroadPhase>
		<!-- brodphase algorithm: octree/SAP/hybrid-->
		<NarrowPhase algorithm="hybrid"></NarrowPhase>
	</Collision>
	<Physics>
		<TimeStep seconds="0.016"></TimeStep>
		<!-- How many times Collision+Physics re-run per visual tick, each
		     against a proportionally smaller timestep (tick/Substeps) -
		     re-detecting collisions against whatever the previous substep
		     just integrated instead of once per visual frame. This is the
		     standard fix modern engines (Box2D v3's TGS Soft, Rapier) use
		     for stacking stability: a body only marginally destabilized
		     (e.g. a stack nudged just past its tipping point) otherwise
		     shows a slow, unrealistic "creep" before visibly toppling,
		     because gravity/torque integration at one big low-frequency
		     step per frame tracks the true continuous-time dynamics poorly
		     near a near-balanced equilibrium. 4 is a common default; 1
		     disables substepping entirely (original behaviour). -->
		<Substeps>4</Substeps>
		<!-- Independent debug-logging toggles via ECX_Logger, each off by
		     default - enable only the one(s) you need, since every awake
		     body/contact point logs at ~10 lines/sec when its flag is on.
		     LogEnergy: total system mechanical energy (kinetic + rotational
		     + gravitational potential, summed across every awake dynamic
		     body), tagged "[ENERGY]" - a real solver bug shows as a
		     sustained increase; kinetic energy alone isn't a useful signal
		     since it legitimately grows anytime something is simply falling.
		     LogVelocity / LogAngularVelocity: per-body linear/angular
		     velocity and position, tagged "[VELOCITY]"/"[ANGULAR_VELOCITY]".
		     LogFriction: per-contact-point normal/tangent impulse and the
		     combined static/kinetic coefficients actually used, tagged
		     "[FRICTION]" - e.g. to catch a static body missing its
		     RigidBody component (and so silently contributing zero
		     friction to every contact, regardless of what the other body's
		     material specifies). -->
		<Debug>
			<LogEnergy>false</LogEnergy>
			<LogVelocity>false</LogVelocity>
			<LogAngularVelocity>false</LogAngularVelocity>
			<LogFriction>false</LogFriction>
		</Debug>
	</Physics>
	
</EngineSettings>