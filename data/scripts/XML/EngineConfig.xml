<?xml version="1.0"?>
<EngineSettings>
	<!-- See README.md ("Engine configuration") for what each setting does. -->
	<Startup pauseOnStart="false"/>
	<Spatial></Spatial>
	<Collision>
		<BroadPhase algorithm="hybrid"></BroadPhase>
		<NarrowPhase algorithm="hybrid"></NarrowPhase>
	</Collision>
	<Physics>
		<TimeStep seconds="0.016"></TimeStep>
		<Substeps>4</Substeps>
		<Debug>
			<LogEnergy>false</LogEnergy>
			<LogVelocity>false</LogVelocity>
			<LogAngularVelocity>false</LogAngularVelocity>
			<LogFriction>false</LogFriction>
		</Debug>
	</Physics>

	<DebugHTTP enabled="false" port="8089"/>
	<EntityLifecycle quarantineFrames="30"/>
	<ComponentStorage initialCapacity="512" growthThreshold="0.95"/>
	<VoxelTerrain enabled="true" script="data/scripts/LUA/TerrainGeneration.lua"/>

</EngineSettings>