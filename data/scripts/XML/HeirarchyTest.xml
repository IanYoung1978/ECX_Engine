<?xml version="1.0"?>
<Scene>
	<!-- Camera -->
	<Entity uid="0" name="camera01">
		<Camera>
			<FOV>60.0</FOV>
			<DrawDistance>100.0</DrawDistance>
		</Camera>
		<Spatial>
			<Position>0.0,5.0,20.0</Position>
			<Orientation>0.0,180.0,0.0</Orientation>
		</Spatial>
		<ScriptComponent>
			<OnKeyDown filename="data/scripts/LUA/OnKeyDown.lua"/>
			<OnKeyUp filename="data/scripts/LUA/OnKeyUp.lua"/>
			<OnKeyHeld filename="data/scripts/LUA/OnKeyHeld.lua"/>
			<OnMouseMove filename="data/scripts/LUA/onMouseMove.lua"/>
		</ScriptComponent>
	</Entity>

	<!-- Lighting -->
	<Entity uid="1" name="directionalLight01">
		<Light>
			<Type>Directional</Type>
			<Direction>1.0,-1.0,0.0,0.0</Direction>
			<Colour>1.0,1.0,1.0,1.0</Colour>
			<Intensity>10.0</Intensity>
			<CastsShadow>true</CastsShadow>
			<Dynamic>false</Dynamic>
		</Light>
	</Entity>

	<!-- Parent box - rotates so children should orbit with it -->
	<Entity uid="100" name="parent_box">
		<Spatial>
			<Position>0.0,3.0,0.0</Position>
			<Orientation>0.0,0.0,0.0</Orientation>
			<AngularVelocity>0.0,45.0,0.0</AngularVelocity>
		</Spatial>
		<Transform>
			<Scale>1.0,1.0,1.0</Scale>
		</Transform>
		<Gfx>
			<Model>data/assets/models/crate.obj</Model>
			<Shader vertex="data/assets/shaders/basic.vert" fragment="data/assets/shaders/PBR.frag"></Shader>
			<Colour>1.0,1.0,1.0,1.0</Colour>
		</Gfx>
	</Entity>

	<!-- Child sphere - offset 3 units to the right of parent -->
	<Entity uid="101" name="child_sphere_red">
		<Spatial>
			<Position>3.0,0.0,0.0</Position>
			<Orientation>0.0,0.0,0.0</Orientation>
		</Spatial>
		<Transform>
			<Scale>0.5,0.5,0.5</Scale>
		</Transform>
		<Gfx>
			<Model>data/assets/models/icosphere.obj</Model>
			<Shader vertex="data/assets/shaders/basic.vert" fragment="data/assets/shaders/PBR.frag"></Shader>
			<Colour>1.0,0.0,0.0,1.0</Colour>
		</Gfx>
		<Hierarchy>
			<Parent uid="100"/>
		</Hierarchy>
	</Entity>

	<!-- Child sphere - offset 3 units to the left of parent -->
	<Entity uid="102" name="child_sphere_blue">
		<Spatial>
			<Position>-3.0,0.0,0.0</Position>
			<Orientation>0.0,0.0,0.0</Orientation>
		</Spatial>
		<Transform>
			<Scale>0.5,0.5,0.5</Scale>
		</Transform>
		<Gfx>
			<Model>data/assets/models/icosphere.obj</Model>
			<Shader vertex="data/assets/shaders/basic.vert" fragment="data/assets/shaders/PBR.frag"></Shader>
			<Colour>0.0,0.0,1.0,1.0</Colour>
		</Gfx>
		<Hierarchy>
			<Parent uid="100"/>
		</Hierarchy>
	</Entity>

	<!-- Ground plane -->
	<Entity uid="200" name="ground">
		<Spatial>
			<Position>0.0,0.0,0.0</Position>
			<Orientation>0.0,0.0,0.0</Orientation>
		</Spatial>
		<Transform>
			<Scale>30.0,0.1,10.0</Scale>
		</Transform>
		<Collider>
			<Type>AABB</Type>
			<Extents>30.0,0.1,10.0</Extents>
			<Layer>2</Layer>
			<Mask>0xFFFFFFFF</Mask>
		</Collider>
		<Gfx>
			<Model>data/assets/models/crate.obj</Model>
			<Shader vertex="data/assets/shaders/basic.vert" fragment="data/assets/shaders/PBR.frag"></Shader>
			<Colour>1.0,1.0,1.0,1.0</Colour>
		</Gfx>
	</Entity>
</Scene>